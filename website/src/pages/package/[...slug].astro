---
import Layout from '../../layouts/Layout.astro';
import {allExtensions, buildDetail, type Extension} from '../../lib/packages';

export async function getStaticPaths() {
    return allExtensions.map((pkg) => ({
        params: {slug: pkg.name},
        props: {pkg},
    }));
}

const {pkg} = Astro.props as {pkg: Extension};
const detail = await buildDetail(pkg);

function timeAgo(dateString: string): string {
    const now = new Date();
    const date = new Date(dateString);
    const seconds = Math.floor((now.getTime() - date.getTime()) / 1000);
    if (seconds < 60) return 'just now';
    if (seconds < 3600) return Math.floor(seconds / 60) + 'm ago';
    if (seconds < 86400) return Math.floor(seconds / 3600) + 'h ago';
    if (seconds < 604800) return Math.floor(seconds / 86400) + 'd ago';
    return date.toLocaleDateString();
}

const categoryLabel: Record<string, string> = {
    'theme': 'Theme',
    'icon-theme': 'Icon Theme',
    'grammar': 'Grammar',
    'language-server': 'Language Server',
    'slash-command': 'Slash Command',
    'context-server': 'MCP Server',
    'agent-server': 'Agent Server',
    'debug-adapter': 'Debug Adapter',
    'docs-provider': 'Docs Provider',
    'snippets': 'Snippets',
};

const title = `${pkg.extension.name || pkg.name} - Zed Extension Safari`;
const description = pkg.description || pkg.extension.description || `Zed extension ${pkg.name}`;
const displayName = pkg.extension.name || pkg.name.split('/')[1];
const authors = (pkg.extension.authors || []).map((author) => author.replace(/\s*<[^>]+>$/, ''));
const zedExtensionUrl = pkg.extension.id ? `https://zed.dev/extensions/${pkg.extension.id}` : 'https://zed.dev/extensions';

const structuredData: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: displayName,
    description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    url: zedExtensionUrl,
    codeRepository: pkg.url,
    ...(authors.length > 0 && {
        author: authors.map((name) => ({'@type': 'Person', name})),
    }),
    ...(pkg.extension.version && {softwareVersion: pkg.extension.version}),
    ...(pkg.license && {license: pkg.license}),
    ...(pkg.extension.categories?.length && {
        keywords: pkg.extension.categories.join(', '),
    }),
    offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
    },
};

const detailRows = [
    pkg.extension.version && ['Version', `v${pkg.extension.version}`],
    pkg.extension.id && ['Extension ID', pkg.extension.id],
    pkg.language && ['Language', pkg.language],
    pkg.license && ['License', pkg.license],
    ['Stars', pkg.stars.toLocaleString()],
    ['Updated', timeAgo(pkg.pushed_at)],
    pkg.extension.schema_version && ['Schema', `v${pkg.extension.schema_version}`],
].filter(Boolean) as [string, string][];
---

<Layout title={title} description={description} structuredData={structuredData}>
    <header class="zed-grid relative" style="border-bottom:1px solid var(--zed-border);">
        <div class="max-w-6xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
            <nav class="text-sm font-mono mb-10">
                <a href={import.meta.env.BASE_URL || '/'}
                   class="transition hover:underline"
                   style="color:var(--zed-blue-deep);">← All extensions</a>
            </nav>

            <div class="max-w-3xl mx-auto text-center">
                <div class="font-mono text-xs mb-3" style="color:var(--zed-muted);">
                    {pkg.name}
                </div>
                <h1 class="text-4xl sm:text-5xl font-semibold break-words leading-tight tracking-tight"
                    style="color:var(--zed-blue-deep);">
                    {displayName}
                </h1>
                {(pkg.extension.description || pkg.description) && (
                    <p class="mt-4 text-base sm:text-lg text-pretty" style="color:var(--zed-text-muted);">
                        {pkg.extension.description || pkg.description}
                    </p>
                )}

                <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
                    {pkg.extension.categories.map((cat) => (
                        <span class="cat-badge" data-cat={cat}>{categoryLabel[cat] || cat}</span>
                    ))}
                </div>
            </div>
        </div>
    </header>

    <main id="main" class="flex-1 max-w-6xl mx-auto w-full px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-[320px_minmax(0,1fr)] lg:items-start">
            <aside class="rounded-lg p-5 lg:sticky lg:top-6"
                   style="background:var(--zed-surface);border:1px solid var(--zed-border);">
                <div class="flex flex-col gap-3">
                    <a href={zedExtensionUrl} target="_blank" rel="noopener"
                       class="zed-btn-primary inline-flex items-center justify-center gap-2 px-4 py-2 rounded-md text-sm font-medium">
                        Open on zed.dev
                        <span aria-hidden="true">↗</span>
                    </a>
                    <a href={pkg.url} target="_blank" rel="noopener"
                       class="zed-btn-ghost inline-flex items-center justify-center gap-2 px-4 py-2 rounded-md text-sm font-medium">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                        View source
                    </a>
                </div>

                <h2 class="mt-6 text-xs uppercase font-mono" style="color:var(--zed-muted);">Details</h2>
                <dl class="mt-3">
                    {detailRows.map(([label, value]) => (
                        <div class="py-3" style="border-top:1px solid var(--zed-border);">
                            <dt class="text-xs font-mono" style="color:var(--zed-muted);">{label}</dt>
                            <dd class="mt-1 text-sm break-words" style="color:var(--zed-text);">{value}</dd>
                        </div>
                    ))}
                    {authors.length > 0 && (
                        <div class="py-3" style="border-top:1px solid var(--zed-border);">
                            <dt class="text-xs font-mono" style="color:var(--zed-muted);">Authors</dt>
                            <dd class="mt-1 text-sm" style="color:var(--zed-text);">{authors.join(', ')}</dd>
                        </div>
                    )}
                </dl>

                {pkg.topics && pkg.topics.length > 0 && (
                    <>
                        <h2 class="mt-5 text-xs uppercase font-mono" style="color:var(--zed-muted);">Topics</h2>
                        <div class="mt-3 flex flex-wrap gap-1.5">
                            {pkg.topics.map((topic) => (
                                <span class="px-2 py-0.5 text-xs rounded-md"
                                      style="background:var(--zed-surface-soft);color:var(--zed-text-muted);border:1px solid var(--zed-border);">
                                    {topic}
                                </span>
                            ))}
                        </div>
                    </>
                )}
            </aside>

            <section class="min-w-0 rounded-lg p-5 sm:p-7"
                     style="background:var(--zed-surface);border:1px solid var(--zed-border);">
                {detail.readme_html ? (
                    <article class="prose readme-prose max-w-none" set:html={detail.readme_html} />
                ) : (
                    <div class="rounded-lg border border-dashed p-8 text-center"
                         style="border-color:var(--zed-border);background:var(--zed-paper);">
                        <p style="color:var(--zed-text-muted);">
                            README not yet indexed for this extension.
                        </p>
                        <p class="mt-2 text-sm" style="color:var(--zed-muted);">
                            Check it directly on <a href={pkg.url} target="_blank" rel="noopener"
                                                    style="color:var(--zed-blue-deep);" class="hover:underline">GitHub</a>.
                        </p>
                    </div>
                )}
            </section>
        </div>
    </main>

    <footer class="mt-auto zed-blue-band">
        <div class="max-w-6xl mx-auto px-4 py-6 sm:px-6 lg:px-8 text-sm"
             style="color:var(--zed-on-accent-muted);">
            <a href={import.meta.env.BASE_URL || '/'} class="hover:underline transition"
               style="color:white;">
                ← Back to extension list
            </a>
        </div>
    </footer>
</Layout>
