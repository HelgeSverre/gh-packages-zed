---
import Layout from '../layouts/Layout.astro';
import PackageFilter from '../components/PackageFilter.svelte';
import extensionsData from '../../../data/extensions.json';
import statsData from '../../../data/stats.json';

const fullPackages = Object.values(extensionsData) as any[];
const stats = statsData as { last_run?: string };

// Slim shape — only the fields the card grid + search + sort actually render.
// Everything else (url, language, license, topics, authors, schema_version)
// is loaded on slideout open from each detail page's <script id="pkg-extras">.
const packages = fullPackages.map((p) => ({
    name: p.name,
    description: p.description,
    stars: p.stars,
    pushed_at: p.pushed_at,
    discovered_at: p.discovered_at,
    extension: p.extension ? {
        id: p.extension.id,
        name: p.extension.name,
        description: p.extension.description,
        version: p.extension.version,
        categories: p.extension.categories,
    } : null,
}));

function timeAgo(dateString: string | undefined): string {
    if (!dateString) return 'recently';
    const now = new Date();
    const date = new Date(dateString);
    const seconds = Math.floor((now.getTime() - date.getTime()) / 1000);
    if (seconds < 60) return 'just now';
    if (seconds < 3600) return Math.floor(seconds / 60) + 'm ago';
    if (seconds < 86400) return Math.floor(seconds / 3600) + 'h ago';
    if (seconds < 604800) return Math.floor(seconds / 86400) + 'd ago';
    return date.toLocaleDateString();
}
---

<Layout
        title="Zed Extension Safari - Discover hidden Zed editor extensions & themes"
        description="Discover fresh Zed editor extensions, themes and language packs that are actively maintained but haven't gone viral yet. Updated every 6 hours."
>
    <header class="zed-grid relative">
        <div class="max-w-7xl mx-auto px-4 pt-14 pb-28 sm:px-6 lg:px-8">
            <a
                    href="https://github.com/HelgeSverre/gh-packages-zed"
                    target="_blank"
                    class="inline-flex items-center gap-2 px-3 py-1 text-xs rounded-md font-mono transition"
                    style="background:var(--zed-surface);border:1px solid var(--zed-border);color:var(--zed-text-muted);"
            >
                <span style="color:var(--zed-blue-deep);">Indexed from GitHub</span>
                <span>{packages.length.toLocaleString()} packages indexed</span>
                <span style="color:var(--zed-blue);">↗</span>
            </a>

            <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(320px,0.45fr)] lg:items-end">
                <div>
            <h1
                    class="text-4xl sm:text-5xl font-semibold tracking-tight text-pretty leading-tight"
                    style="color:var(--zed-blue-deep);"
            >
                Zed Extension Safari
            </h1>
            <p class="mt-5 text-base sm:text-lg max-w-2xl text-pretty"
               style="color:var(--zed-text-muted);">
                A searchable field guide for Zed extensions, themes, languages, MCP servers and agent servers. Refreshed every 6 hours from GitHub and the official Zed registry.
            </p>

            <div class="mt-8 flex items-center gap-3 flex-wrap">
                <a
                        href="https://zed.dev/extensions"
                        target="_blank"
                        class="zed-btn-primary inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium"
                >
                    Browse on zed.dev
                    <span class="inline-flex items-center justify-center w-5 h-5 rounded text-xs font-mono"
                          style="background:rgba(255,255,255,0.18);">↗</span>
                </a>
                <a
                        href="https://github.com/HelgeSverre/gh-packages-zed"
                        target="_blank"
                        class="zed-btn-ghost inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium"
                >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                    View source
                </a>
            </div>
                </div>

                <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-lg"
                    style="border:1px solid var(--zed-border);background:var(--zed-border);">
                    <div class="p-4" style="background:var(--zed-surface);">
                        <dt class="text-xs uppercase font-mono" style="color:var(--zed-muted);">Indexed</dt>
                        <dd class="mt-2 text-2xl font-semibold" style="color:var(--zed-text);">{packages.length.toLocaleString()}</dd>
                    </div>
                    <div class="p-4" style="background:var(--zed-surface);">
                        <dt class="text-xs uppercase font-mono" style="color:var(--zed-muted);">Updated</dt>
                        <dd class="mt-2 text-2xl font-semibold" style="color:var(--zed-text);">{timeAgo(stats.last_run)}</dd>
                    </div>
                    <div class="col-span-2 p-4" style="background:var(--zed-accent-bg);color:var(--zed-accent-fg);">
                        <dt class="text-xs uppercase font-mono" style="color:var(--zed-on-accent-muted);">Coverage</dt>
                        <dd class="mt-2 text-sm">
                            Extension manifests, README previews, categories, versions, authors and repository metadata.
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Soft bottom fade into the body -->
        <div class="absolute inset-x-0 bottom-0 h-32 pointer-events-none"
             style="background:linear-gradient(to bottom, transparent, var(--zed-bg));"></div>
    </header>

    <PackageFilter packages={packages} client:idle />

    <footer class="mt-auto zed-blue-band">
        <div
                class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm"
                style="color:var(--zed-on-accent-muted);"
        >
            <p>Updated {timeAgo(stats.last_run)} · Pulls from GitHub every 6 hours</p>
            <p>
                Made by <a
                    href="https://helgesver.re"
                    class="transition font-medium"
                    style="color:white;"
            >Helge Sverre</a
            >
            </p>
        </div>
    </footer>
</Layout>
